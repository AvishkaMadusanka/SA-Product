# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication & Security Secrets
# IMPORTANT: Generate a strong, random string (minimum 32 characters) for JWT_SECRET in production.
# Example generator: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=24h

# Optional token required when bootstrapping/registering an admin user
ADMIN_BOOTSTRAP_TOKEN=replace_with_secure_bootstrap_token_if_needed

# Database (optional if using MongoDB / MySQL in future)
# DB_URI=mongodb://localhost:27017/saproduct
